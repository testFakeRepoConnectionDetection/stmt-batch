//STMT030  JOB (CARDS),'STMT DISTRIB',CLASS=A,MSGCLASS=X
//*
//* PRINT FILE TO THE PRINT SHOP, TOTALS TO RECONCILIATION, READY MESSAGE FOR E-STATEMENTS
//*
//TOPRINT  EXEC PGM=FTP,PARM='sftp.print-partner.eu (EXIT'
//INPUT    DD *
cd /in/statements/eu
put 'CRD.STMT.PRINT.OUT' STMT_EU.afp
quit
/*
//TORECON  EXEC PGM=DMBATCH
//SYSIN    DD *
  SIGNON
  SUBMIT PROC=RECONTOT SNODE=RECON.EU.NDM -
     &DSN1=CRD.STMT.TOTALS
  SIGNOFF
/*
//NOTIFY   EXEC PGM=STMTNTF
//STEPLIB  DD DSN=CRD.STMT.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
